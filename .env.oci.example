# OCI Environment Variables Template
# Copy this to .env and fill in real values before deploying

# === AI Services ===
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# === Neo4j Database ===
# These are used by both the docker-compose NEO4J_AUTH and the app
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Change_Me_In_Production!

# === Authentication ===
# Generate a strong random string: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_strong_secret_key

# === CORS ===
# Replace with your OCI VM public IP or custom domain (comma-separated, no trailing slash)
# Example: http://152.70.x.x  or  https://myea.example.com
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# === Frontend ===
# When running behind Nginx on OCI, the frontend calls /api/* which Nginx rewrites.
# Leave as /api for production, or set to http://localhost:8000 for local dev.
NEXT_PUBLIC_BACKEND_URL=/api
