# === AI Services ===
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# === Neo4j Database ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# === Authentication ===
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_strong_secret_key

# === CORS ===
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# === Frontend ===
# URL the frontend server-side code uses to reach the backend.
# For local dev, point to localhost. For Docker Compose, use http://app:8000.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
