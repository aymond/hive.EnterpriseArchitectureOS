# === AI Services ===
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# Optional: CLI only (`python main.py process "..."`). Web UI uses Profile → LLM model.
# OPENAI_LLM_MODEL=gpt-4o

# === Neo4j Database ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# === Authentication ===
# Generate JWT key with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_strong_secret_key

# Generate FERNET encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode('utf-8'))"
FERNET_SECRET_KEY=replace_with_a_strong_fernet_key

# === CORS ===
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# === Frontend ===
# URL the frontend server-side code uses to reach the backend.
# For local dev, point to localhost. For Docker Compose, use http://app:8000.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# === Ollama / OpenAI-compatible (Profile UI) ===
# Chat uses the OpenAI shim at …/v1/chat/completions (not the “Ollama is running” page at /).
# If you run this stack with Docker Compose but Ollama on the host, set Profile base URL to:
#   http://host.docker.internal:11434/v1
# (docker-compose adds host.docker.internal for the app container.)
#
# The API auto-rewrites localhost/127.0.0.1 in the LLM base URL to host.docker.internal
# when running inside Docker. Set DISABLE_LLM_DOCKER_HOST_REWRITE=1 to turn that off.
# If Ollama still refuses connections from Docker, set Ollama to listen on all interfaces, e.g.:
#   OLLAMA_HOST=0.0.0.0 ollama serve
